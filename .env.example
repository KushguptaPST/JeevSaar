# Server Environment Variables
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Database
DATABASE_URL="postgresql://copilot:copilot@localhost:5432/report_saathi?schema=public"

# JWT Secret
JWT_SECRET="reportsaathi_dev_jwt_secret_change_in_production_min_32_chars"

# Admin Static Token for Hospital Desk
ADMIN_API_TOKEN="admin_hospital_desk_secret_token_123"

# Providers
SMS_PROVIDER=mock
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
LLM_PROVIDER=mock
TTS_PROVIDER=mock

# Real Provider Keys (placeholders for production)
SARVAM_API_KEY="YOUR_SARVAM_AI_API_KEY_HERE"
OPENAI_API_KEY="YOUR_OPENAI_API_KEY_HERE"

# Data Retention (days)
DATA_RETENTION_DAYS=30

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=60000
